# =============================================================================
# TrussC .gitignore
# =============================================================================

# Build artifacts
build/
build-*/
xcode*/
out/
cmake-build-*/
*.a
*.o
*.d
*.lib
*.obj
*.exe
*.dll
*.dylib
*.so
*.pdb

# macOS
.DS_Store
*.dSYM/

# =============================================================================
# IDE / Editor
# =============================================================================

# Visual Studio Code
.vscode/

# Visual Studio
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate

# JetBrains (CLion)
.idea/
*.iml

# =============================================================================
# CMake
# =============================================================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
_deps/

# clangd cache
.cache/

# =============================================================================
# Examples
# =============================================================================

# Exclude build artifacts in examples (including subfolders)
examples/**/build/
examples/**/bin/*
!examples/**/bin/data/
examples/**/out/
examples/**/*.xcodeproj/
examples/**/*.sln
examples/**/*.vcxproj

# =============================================================================
# Addons
# =============================================================================

# Exclude build artifacts in addons
addons/**/build/
addons/**/_fcache/
addons/**/bin/*
!addons/**/bin/data/
addons/**/*.xcodeproj/
addons/**/*.sln
addons/**/*.vcxproj

# =============================================================================
# Exclude Non official addons
# =============================================================================

addons/*
!addons/tcxBox2d
!addons/tcxMidi
!addons/tcxCurl
!addons/tcxImGui
!addons/tcxNodeInspector
!addons/tcxHap
!addons/tcxLua
!addons/tcxLut
!addons/tcxOsc
!addons/tcxQuadWarp
!addons/tcxTls
!addons/tcxWebSocket
!addons/tcxGltf
!addons/tcxObj
!addons/tcxFontLayout
!addons/tcxOpenCV
!addons/tcxCV
!addons/tcxFlowTools
!addons/tcxIOS
!addons/tcxTraerPhysics
!addons/tcxArtNet
!addons/tcxAssimp
!addons/tcxCloth
!addons/tcxDepthCamera
!addons/tcxDepthRecord
!addons/tcxMapWrap
!addons/tcxCEF
!addons/tcxMediaPipe
!addons/tcxAruco
!addons/tcxAzureKinect
!addons/tcxGPT
!addons/tcxGlitch
!addons/tcxIME
!addons/tcxMQTT
!addons/tcxPhysics
!addons/tcxPly
!addons/tcxSyphon
addons/tcxCloth/*task*.md
addons/tcxArtNet/ref/
addons/tcxArtNet/tcxArtNet_addon_task_spec.md

# =============================================================================
# trusscli / Project Generator (built binary + build artifacts in tools/)
# =============================================================================

# Exclude trusscli binaries and build output (only source is tracked).
# trusscli is the single binary that backs both the CLI and the GUI
# ("TrussC Project Generator").
tools/trusscli.app
tools/trusscli.exe
tools/trusscli
tools/bin/
tools/build/

# =============================================================================
# Tools (auto-downloaded)
# =============================================================================

# Tools like sokol-shdc are auto-downloaded on first build
core/tools/
docs/scripts/node_modules/

# =============================================================================
# Project Generator Auto-generated Files
# =============================================================================
examples/**/CMakePresets.json
examples/**/build-web.command
examples/**/build-web.bat
examples/**/build-web.sh
addons/**/CMakePresets.json
addons/**/build-web.command
addons/**/build-web.bat
addons/**/build-web.sh
examples/CMakeLists.txt
addons/CMakeLists.txt

# Addon-local AI handoff/planning notes should stay local.
addons/**/HANDOFF*.md
addons/**/*_Codex_Taskbook.md
addons/**/ITERATION_STATUS.md
addons/tcxAssimp/tcxAssimp_TrussC_移植任务书_v2.md

# =============================================================================
# AI generated audits, reviews, checklists, task specs (keep local only)
# =============================================================================
addons/**/*audit*
addons/**/*Audit*
addons/**/*review*
addons/**/*Review*
addons/**/*checklist*
addons/**/*Checklist*
addons/**/*任务书*
addons/**/*_建议*
addons/**/*_task_spec*
addons/**/*_Code_Review*
addons/**/*_code_review*
addons/**/*_audit*
addons/**/docs/final_checklist.md
addons/**/docs/platform_notes.md
addons/**/*_TrussC_Modern*

# Tests directories in addons (local dev only)
addons/**/tests/
addons/**/tests/*
addons/**/test/

# Dev tool scripts in addons (local only)
addons/**/scripts/

# =============================================================================
# Auto-generated Shader Headers (sokol-shdc output)
# =============================================================================
core/include/tc/gpu/shaders/*.glsl.h

# =============================================================================
# AI assistant local state
# =============================================================================
# Project-local state/settings from AI coding tools. Root-level instruction
# files like CLAUDE.md / GEMINI.md / AGENTS.md are intentionally *not* ignored
# since those are meant to be shared.
.claude/
.gemini/
.codex/
.cursor/
.windsurf/
.continue/
.amazonq/
.cline/
.clinerules/
.aider*

